  "meta": {
    "title": "A 198-state machine that halts only if set theory C₀ is inconsistent",
    "blurb": "A 198-state, 2-symbol Turing machine by wlad-svennik that searches for a contradiction in C₀, a set theory related to Quine's New Foundations (NF). It halts from a blank tape only if C₀ is inconsistent, so if NF is consistent it runs forever.",
    "library": {
      "author": {
        "login": "thethinkmachine",
        "name": "Shreyan Chaubey"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "independence",
        "new-foundations",
        "set-theory",
        "busy-beaver",
        "halting-problem",
        "bbchallenge",
        "record"
      ],
      "difficulty": "advanced",
      "chapter": "https://github.com/wlad-svennik/notes/tree/main/c0-198"
    }
  }
}
