  "meta": {
    "title": "K215: a 215-state machine that halts only if ZFC is inconsistent",
    "blurb": "A 215-state, 2-symbol Turing machine from Vladimir Reshetnikov's ProveIt project that searches for a contradiction in ZFC, the usual axioms of mathematics. Lean and Rocq have checked that it halts from a blank tape if and only if ZFC is inconsistent, so if ZFC is consistent it runs forever and ZFC cannot prove that.",
    "library": {
      "author": {
        "login": "thethinkmachine",
        "name": "Shreyan Chaubey"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "independence",
        "zfc",
        "set-theory",
        "busy-beaver",
        "halting-problem",
        "bbchallenge",
        "record",
        "lean",
        "rocq"
      ],
      "difficulty": "advanced",
      "chapter": "https://github.com/VladimirReshetnikov/ProveIt"
    }
  }
}
