{
  "machine": "NDTM",
  "sigma": [
    "0",
    "1"
  ],
  "stackAlpha": [
    "0",
    "1",
    "⊔"
  ],
  "tapeCount": 1,
  "states": [
    {
      "id": "s1",
      "x": 120,
      "y": 200,
      "name": "scan"
    },
    {
      "id": "s2",
      "x": 360,
      "y": 200,
      "name": "guess-last-1"
    },
    {
      "id": "s3",
      "x": 600,
      "y": 200,
      "name": "acc"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s3"
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "0",
      "write": "0",
      "dir": "R"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "1",
      "write": "1",
      "dir": "R"
    },
    {
      "id": "t3",
      "from": "s1",
      "to": "s2",
      "symbol": "1",
      "write": "1",
      "dir": "R"
    },
    {
      "id": "t4",
      "from": "s2",
      "to": "s3",
      "symbol": "⊔",
      "write": "⊔",
      "dir": "S"
    }
  ],
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "Guess the last 1",
    "blurb": "Accepts binary strings ending in 1. The machine moves right and, on some 1, guesses that it is the last symbol; the guess is confirmed when the next cell is blank. The nondeterministic Turing machine in its smallest form.",
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "textbook",
        "ndtm"
      ],
      "difficulty": "intro"
    },
    "inputs": [
      {
        "w": "1",
        "expect": "accept"
      },
      {
        "w": "01",
        "expect": "accept"
      },
      {
        "w": "1011",
        "expect": "accept"
      },
      {
        "w": "",
        "expect": "reject"
      },
      {
        "w": "0",
        "expect": "reject"
      },
      {
        "w": "10",
        "expect": "reject"
      },
      {
        "w": "0110",
        "expect": "reject"
      }
    ]
  }
}
