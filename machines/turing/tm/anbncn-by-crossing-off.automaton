  "meta": {
    "title": "aⁿbⁿcⁿ by crossing off",
    "blurb": "The single-tape decider for the classic non-context-free language: each pass marks one a as X, one b as Y and one c as Z, then walks back to the last X. When no a is left, a final sweep checks that only Y’s and Z’s remain.",
    "inputs": [
      {
        "w": "",
        "expect": "accept"
      },
      {
        "w": "abc",
        "expect": "accept"
      },
      {
        "w": "aabbcc",
        "expect": "accept"
      },
      {
        "w": "aaabbbccc",
        "expect": "accept"
      },
