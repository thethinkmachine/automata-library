{
  "machine": "TM",
  "sigma": [
    "0",
    "1"
  ],
  "stackAlpha": [
    "0",
    "1",
    "⊔"
  ],
  "states": [
    {
      "id": "s1",
      "x": 120,
      "y": 200,
      "name": "right"
    },
    {
      "id": "s2",
      "x": 340,
      "y": 200,
      "name": "inc"
    },
    {
      "id": "s3",
      "x": 560,
      "y": 200,
      "name": "acc"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s3"
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "0",
      "write": "0",
      "dir": "R"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "1",
      "write": "1",
      "dir": "R"
    },
    {
      "id": "t3",
      "from": "s1",
      "to": "s2",
      "symbol": "⊔",
      "write": "⊔",
      "dir": "L"
    },
    {
      "id": "t4",
      "from": "s2",
      "to": "s2",
      "symbol": "1",
      "write": "0",
      "dir": "L"
    },
    {
      "id": "t5",
      "from": "s2",
      "to": "s3",
      "symbol": "0",
      "write": "1",
      "dir": "R"
    },
    {
      "id": "t6",
      "from": "s2",
      "to": "s3",
      "symbol": "⊔",
      "write": "1",
      "dir": "R"
    }
  ],
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "Binary increment",
    "blurb": "Adds one to a binary number, most significant bit first. Run to the right end, then turn every trailing 1 into 0 until a 0 (or the blank before the number) takes the carry. 1011 becomes 1100; 111 grows into 1000.",
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "textbook",
        "tm"
      ],
      "difficulty": "intro"
    },
    "inputs": [
      {
        "w": "0",
        "expect": "accept",
        "label": "0 + 1",
        "tape": "1"
      },
      {
        "w": "1011",
        "expect": "accept",
        "label": "11 + 1",
        "tape": "1100"
      },
      {
        "w": "111",
        "expect": "accept",
        "label": "7 + 1",
        "tape": "1000"
      },
      {
        "w": "1001",
        "expect": "accept",
        "label": "9 + 1",
        "tape": "1010"
      }
    ]
  },
  "config": {
    "twoWayTape": true
  }
}
