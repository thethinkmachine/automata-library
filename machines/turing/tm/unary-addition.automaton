  "meta": {
    "title": "Unary addition",
    "blurb": "m ones, a plus sign, n ones: turn the + into a 1 and erase the last 1. The tape then holds m + n ones — addition in unary is a two-symbol edit, which is why the first machines in every course use it.",
    "inputs": [
      {
        "w": "+",
        "expect": "accept"
      },
      {
        "w": "1+11",
        "expect": "accept"
      },
      {
        "w": "+1",
        "expect": "accept"
      },
      {
        "w": "1111+111111",
        "expect": "accept"
      },
      {
        "w": "1",
        "expect": "reject"
      },
      {
        "w": "++11",
        "expect": "reject"
      },
      {
        "w": "11",
        "expect": "reject"
      },
      {
        "w": "+111+111111",
        "expect": "reject"
      }
    ],
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "arithmetic",
        "unary",
        "computing-a-function"
      ],
      "difficulty": "intro"
    }
  }
