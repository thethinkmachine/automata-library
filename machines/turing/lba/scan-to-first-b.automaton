{
  "machine": "LBA",
  "sigma": [
    "a",
    "b"
  ],
  "stackAlpha": [
    "⊢",
    "a",
    "b",
    "⊔",
    "⊣"
  ],
  "tapeCount": 1,
  "states": [
    {
      "id": "s1",
      "x": 200,
      "y": 200,
      "name": "scan"
    },
    {
      "id": "s2",
      "x": 400,
      "y": 200,
      "name": "acc"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s2"
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "⊢",
      "write": "⊢",
      "dir": "R"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "write": "a",
      "dir": "R"
    },
    {
      "id": "t3",
      "from": "s1",
      "to": "s2",
      "symbol": "b",
      "write": "b",
      "dir": "S"
    }
  ],
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "Scan to the first b",
    "blurb": "An LBA that reads right from the ⊢ endmarker and accepts at the first b. If it reaches ⊣ first there is no move, and the word is rejected — the endmarkers are what make a linear bounded automaton’s tape finite.",
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "textbook",
        "lba"
      ],
      "difficulty": "intro"
    },
    "inputs": [
      {
        "w": "b",
        "expect": "accept"
      },
      {
        "w": "ab",
        "expect": "accept"
      },
      {
        "w": "aaab",
        "expect": "accept"
      },
      {
        "w": "abaa",
        "expect": "accept"
      },
      {
        "w": "",
        "expect": "reject"
      },
      {
        "w": "a",
        "expect": "reject"
      },
      {
        "w": "aaa",
        "expect": "reject"
      }
    ]
  }
}
