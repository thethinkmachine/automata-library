{
  "machine": "ε-NFA",
  "sigma": [
    "a",
    "b"
  ],
  "states": [
    {
      "id": "s1",
      "x": 100,
      "y": 200,
      "name": "start"
    },
    {
      "id": "s2",
      "x": 300,
      "y": 120,
      "name": "a_star"
    },
    {
      "id": "s3",
      "x": 300,
      "y": 280,
      "name": "b_star"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s1",
    "s2",
    "s3"
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s2",
      "symbol": "ε"
    },
    {
      "id": "t2",
      "from": "s2",
      "to": "s3",
      "symbol": "ε"
    },
    {
      "id": "t3",
      "from": "s2",
      "to": "s2",
      "symbol": "a"
    },
    {
      "id": "t4",
      "from": "s3",
      "to": "s3",
      "symbol": "b"
    }
  ],
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "a* then b* — joined by ε",
    "blurb": "Some a’s followed by some b’s. Each block is one looping state, and an ε-move lets the machine pass from the a’s to the b’s without reading anything. Every state accepts, so the question is only whether the order is ever broken.",
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "textbook",
        "nfa"
      ],
      "difficulty": "intro"
    },
    "inputs": [
      {
        "w": "",
        "expect": "accept",
        "label": "ε"
      },
      {
        "w": "aaa",
        "expect": "accept"
      },
      {
        "w": "bb",
        "expect": "accept"
      },
      {
        "w": "aabbb",
        "expect": "accept"
      },
      {
        "w": "ba",
        "expect": "reject"
      },
      {
        "w": "aba",
        "expect": "reject"
      },
      {
        "w": "abab",
        "expect": "reject"
      }
    ]
  }
