      {
        "w": "cat",
        "expect": "accept"
      },
      {
        "w": "at",
        "expect": "accept"
      },
      {
        "w": "caxt",
        "expect": "accept"
      },
      {
        "w": "cxt",
        "expect": "accept"
      },
      {
        "w": "xcat",
        "expect": "accept"
      },
