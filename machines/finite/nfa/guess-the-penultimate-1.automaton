    "1"
  ],
  "states": [
    {
      "id": "s1",
      "x": 100,
      "y": 200,
      "name": "start"
    },
    {
      "id": "s2",
      "x": 250,
      "y": 200,
      "name": "guess"
    },
    {
      "id": "s4",
      "x": 400,
      "y": 200,
      "name": "acc"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s4"
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "0"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "1"
    },
    {
      "id": "t3",
      "from": "s1",
      "to": "s2",
      "symbol": "1"
    },
    {
      "id": "t4",
      "from": "s2",
      "to": "s4",
      "symbol": "0"
    },
    {
      "id": "t5",
      "from": "s2",
      "to": "s4",
      "symbol": "1"
    }
  ],
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "Guess the penultimate 1",
    "blurb": "Accepts binary strings whose second-to-last symbol is 1. On every 1 the machine may bet that it is the penultimate symbol; the bet is right when exactly one symbol follows. Three states, where a DFA needs four.",
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "textbook",
        "nfa"
      ],
      "difficulty": "intro"
    },
    "inputs": [
      {
        "w": "10",
        "expect": "accept"
      },
      {
        "w": "11",
        "expect": "accept"
      },
      {
        "w": "0110",
        "expect": "accept"
      },
      {
        "w": "1011",
        "expect": "accept"
      },
      {
        "w": "",
        "expect": "reject"
      },
      {
        "w": "1",
        "expect": "reject"
      },
      {
        "w": "01",
        "expect": "reject"
      },
      {
        "w": "1001",
        "expect": "reject"
      }
    ]
  }
