  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "Guess an a, then check",
    "blurb": "Accepts every word containing an a. The head moves right and, at some a, guesses “this is the one”; the guess is confirmed by reaching the right endmarker in found_a. Nondeterminism and two-way movement, in their smallest form.",
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "textbook",
        "2nfa"
      ],
      "difficulty": "intro"
    },
    "inputs": [
