      "tags": [
        "textbook",
        "sipser",
        "forbidden-pattern",
        "partial-dfa"
      ],
      "difficulty": "intro",
      "chapter": "Sipser, Introduction to the Theory of Computation, exercises to chapter 1"
    }
  }
