    },
    {
      "id": "s3",
      "x": 498,
      "y": 160,
      "name": "z1"
    },
    {
      "id": "s4",
      "x": 677,
      "y": 160,
      "name": "z2"
    },
    {
      "id": "s5",
      "x": 856,
      "y": 160,
      "name": "z3"
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "0"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s2",
      "symbol": "1"
    },
    {
      "id": "t3",
      "from": "s2",
      "to": "s3",
      "symbol": "0"
    },
    {
      "id": "t4",
      "from": "s3",
      "to": "s4",
      "symbol": "0"
    },
    {
