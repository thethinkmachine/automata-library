  "notes": [],
  "dividers": [],
  "blocks": [],
  "meta": {
    "title": "An identifier",
    "blurb": "A letter or underscore, then letters, digits and underscores: a stands for any letter, 0 for any digit. The first symbol is the only one with a restriction.",
    "inputs": [
      {
        "w": "_",
        "expect": "accept"
      },
      {
        "w": "_00__a0",
        "expect": "accept"
      },
      {
        "w": "_0aa_",
        "expect": "accept"
      },
      {
        "w": "_0_a00a_aaaa__",
        "expect": "accept"
      },
      {
        "w": "0",
        "expect": "reject"
      },
      {
        "w": "000__a0",
        "expect": "reject"
      },
      {
        "w": "00aa_",
        "expect": "reject"
      },
      {
        "w": "00_a00a_aaaa__",
        "expect": "reject"
      }
    ],
