{
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "machine": "DFA",
  "config": {
    "sym": {
      "eps": "ε",
      "any": "Σ",
      "blank": "⊔",
      "leftMarker": "⊢",
      "rightMarker": "⊣",
      "stackBottom": "Z",
      "lambda": "λ"
    }
  },
  "sigma": [
    "0",
    "1"
  ],
  "stackAlpha": [],
  "outputAlpha": [],
  "tapeCount": 1,
  "states": [
    {
      "id": "s1",
      "name": "nothing",
      "x": 0,
      "y": 0
    },
    {
      "id": "s2",
      "name": "saw 1",
      "x": 179,
      "y": 0
    },
    {
      "id": "s3",
      "name": "saw 10",
      "x": 358,
      "y": 0
    },
    {
      "id": "s4",
      "name": "found 101",
      "x": 537,
      "y": 0
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "0"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s2",
      "symbol": "1"
    },
    {
      "id": "t3",
      "from": "s2",
      "to": "s2",
      "symbol": "1"
    },
    {
      "id": "t4",
      "from": "s2",
      "to": "s3",
      "symbol": "0"
    },
    {
      "id": "t5",
      "from": "s3",
      "to": "s1",
      "symbol": "0"
    },
