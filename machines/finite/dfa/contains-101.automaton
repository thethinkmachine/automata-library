      "id": "t6",
      "from": "s3",
      "to": "s4",
      "symbol": "1"
    },
    {
      "id": "t7",
      "from": "s4",
      "to": "s4",
      "symbol": "0"
    },
    {
      "id": "t8",
      "from": "s4",
