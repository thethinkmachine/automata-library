      "name": "even"
    },
    {
      "id": "s2",
      "x": 319,
      "y": 160,
      "name": "odd"
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s2",
      "symbol": "a"
    },
    {
      "id": "t2",
      "from": "s2",
      "to": "s1",
      "symbol": "b"
    },
    {
