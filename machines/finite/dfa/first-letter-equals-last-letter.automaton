  "meta": {
    "title": "First letter equals last letter",
    "blurb": "Words that begin and end with the same letter. The first symbol is remembered forever by choosing a half of the machine; after that, each half only tracks the latest letter.",
    "inputs": [
      {
        "w": "a",
        "expect": "accept"
      },
      {
        "w": "aba",
        "expect": "accept"
      },
      {
        "w": "bab",
        "expect": "accept"
      },
      {
        "w": "abbba",
        "expect": "accept"
      },
      {
        "w": "",
        "expect": "reject"
      },
      {
        "w": "ab",
        "expect": "reject"
      },
      {
        "w": "ba",
        "expect": "reject"
      },
      {
        "w": "aabab",
        "expect": "reject"
      }
    ],
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "memory",
        "textbook"
      ],
      "difficulty": "intro",
      "readme": "The first move splits the machine in two, and it never crosses back: everything reachable after an **a** remembers that the word began with a. Inside each half, the state is simply the most recent letter.\n\nA single letter is accepted (it is both first and last). The empty word has no first letter and is rejected."
    }
  }
}
