  "meta": {
    "title": "Ends in 01",
    "blurb": "Three states remember how much of the suffix 01 has just been read. A 0 always means \"maybe starting it\", so no state ever has to back up further than one symbol.",
    "inputs": [
      {
        "w": "01",
        "expect": "accept"
      },
      {
        "w": "11001",
        "expect": "accept"
      },
      {
        "w": "001",
        "expect": "accept"
      },
      {
        "w": "0000001101",
        "expect": "accept"
      },
      {
        "w": "11",
        "expect": "reject"
      },
      {
        "w": "11011",
        "expect": "reject"
      },
      {
        "w": "011",
        "expect": "reject"
      },
      {
        "w": "0000001111",
        "expect": "reject"
      }
