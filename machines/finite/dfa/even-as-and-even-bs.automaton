  "meta": {
    "title": "Even a’s and even b’s",
    "blurb": "The product construction in four states: one parity bit for the a’s times one for the b’s. Reading a flips the horizontal bit, reading b the vertical one, and only the corner where both are even accepts.",
    "inputs": [
      {
        "w": "",
        "expect": "accept"
      },
      {
        "w": "abab",
        "expect": "accept"
      },
      {
        "w": "abba",
        "expect": "accept"
      },
      {
        "w": "aabb",
        "expect": "accept"
      },
      {
        "w": "ab",
        "expect": "reject"
      },
      {
        "w": "aab",
        "expect": "reject"
      },
      {
        "w": "babbb",
        "expect": "reject"
      }
