  "meta": {
    "title": "Exactly two b’s",
    "blurb": "Count the b’s and stop counting at two: any a leaves the count alone, and a third b has nowhere to go.",
    "inputs": [
      {
        "w": "bb",
        "expect": "accept"
      },
      {
