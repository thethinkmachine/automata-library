  "meta": {
    "title": "Sipser’s M2: ends in 1",
    "blurb": "Two states that record only the last symbol read; the accepting one is “the last symbol was a 1”. The smallest machine whose state means something.",
    "inputs": [
      {
        "w": "1",
        "expect": "accept"
      },
      {
        "w": "10011",
        "expect": "accept"
      },
      {
        "w": "01",
        "expect": "accept"
      },
      {
        "w": "0000001011",
        "expect": "accept"
      },
      {
        "w": "0",
        "expect": "reject"
      },
      {
        "w": "10010",
        "expect": "reject"
      },
      {
        "w": "00",
        "expect": "reject"
      },
      {
        "w": "0000001010",
        "expect": "reject"
