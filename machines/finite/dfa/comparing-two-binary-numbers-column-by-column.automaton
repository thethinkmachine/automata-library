  "meta": {
    "title": "Comparing two binary numbers, column by column",
    "blurb": "Each symbol is a column: the top number’s bit, then the bottom one’s. Reading from the most significant end, the first column that differs decides — after that nothing can change the answer.",
    "inputs": [
      {
        "w": "10",
        "expect": "accept"
      },
      {
        "w": "00 10 01 11",
        "expect": "accept"
      },
      {
        "w": "00 00 11 10 10 11 01 01",
        "expect": "accept"
      },
      {
        "w": "00 10 10 01 01 10 10 00 10 11 11 00 01 00",
        "expect": "accept"
      },
      {
        "w": "00",
        "expect": "reject"
      },
      {
        "w": "01 10 01 11",
        "expect": "reject"
      },
      {
        "w": "01 00 11 10 10 11 01 01",
        "expect": "reject"
      },
      {
        "w": "01 10 10 01 01 10 10 00 10 11 11 00 01 00",
        "expect": "reject"
      }
    ],
