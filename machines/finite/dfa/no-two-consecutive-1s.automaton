  "meta": {
    "title": "No two consecutive 1s",
    "blurb": "Binary strings with no 11 in them. The number of accepted strings of length n is the Fibonacci number $F_{n+2}$: a string ending in 0 extends any good string, one ending in 1 only a good string ending in 0.",
    "inputs": [
      {
        "w": "",
        "expect": "accept"
      },
      {
        "w": "10101",
        "expect": "accept"
      },
      {
        "w": "1001",
        "expect": "accept"
      },
      {
        "w": "0100",
        "expect": "accept"
      },
      {
        "w": "11",
        "expect": "reject"
      },
      {
        "w": "0110",
        "expect": "reject"
      },
      {
        "w": "10111",
        "expect": "reject"
