  "notes": [],
  "dividers": [],
  "blocks": [],
  "meta": {
    "title": "Starts with 1 and ends with 0",
    "blurb": "A first symbol that decides everything: a leading 0 sends the machine to a state it never leaves. After a leading 1, only the last symbol matters.",
    "inputs": [
      {
        "w": "10",
        "expect": "accept"
      },
      {
        "w": "100110",
        "expect": "accept"
      },
      {
        "w": "100",
        "expect": "accept"
      },
      {
        "w": "1000000110",
        "expect": "accept"
      },
      {
        "w": "00",
        "expect": "reject"
      },
      {
        "w": "000110",
        "expect": "reject"
      },
      {
        "w": "000",
        "expect": "reject"
      },
      {
        "w": "0000000110",
        "expect": "reject"
      }
    ],
    "library": {
