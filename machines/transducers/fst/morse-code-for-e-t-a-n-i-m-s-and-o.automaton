        "out": ".-/.-/"
      },
      {
        "w": "ae",
        "out": ".-/./"
      },
      {
        "w": "aaa",
        "out": ".-/.-/.-/"
      },
      {
        "w": "ttoonomitost",
        "out": "-/-/---/---/-./---/--/../-/---/.../-/"
      }
