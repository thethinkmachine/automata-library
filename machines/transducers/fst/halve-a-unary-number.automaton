      "id": "s1",
      "name": "even so far",
      "x": 0,
      "y": 0
    },
    {
      "id": "s2",
      "name": "odd so far",
      "x": 179,
      "y": 0
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s2",
