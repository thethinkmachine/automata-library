{
  "machine": "FST",
  "sigma": [
    "a",
    "b"
  ],
  "outputAlpha": [
    "0",
    "1",
    "X"
  ],
  "states": [
    {
      "id": "s1",
      "x": 300,
      "y": 220,
      "name": "q0"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s1"
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "output": "0"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "output": "1"
    },
    {
      "id": "t3",
      "from": "s1",
      "to": "s1",
      "symbol": "b",
      "output": "X"
    }
  ],
  "config": {
    "transducerAccepts": false
  },
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "Nondeterministic rewriter",
    "blurb": "Every a may become 0 or 1, and every b becomes X. A transducer need not be a function: this one gives 2ᵏ outputs for a word with k a’s, and the simulator lists them all. A relation between words, drawn with one state.",
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "textbook",
        "fst"
      ],
      "difficulty": "intro"
    },
    "inputs": [
      {
        "w": "b",
        "out": "X"
      },
      {
        "w": "a",
        "out": "0 | 1"
      },
      {
        "w": "ab",
        "out": "0X | 1X"
      },
      {
        "w": "bab",
        "out": "X0X | X1X"
      },
      {
        "w": "aa",
        "out": "00 | 01 | 10 | 11"
      }
    ]
  }
}
