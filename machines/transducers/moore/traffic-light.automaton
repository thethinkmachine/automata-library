{
  "machine": "Moore",
  "sigma": [
    "tick"
  ],
  "outputAlpha": [
    "RED",
    "GREEN",
    "YELLOW"
  ],
  "states": [
    {
      "id": "s1",
      "x": 160,
      "y": 200,
      "name": "q_red",
      "output": "RED"
    },
    {
      "id": "s2",
      "x": 360,
      "y": 200,
      "name": "q_green",
      "output": "GREEN"
    },
    {
      "id": "s3",
      "x": 560,
      "y": 200,
      "name": "q_yellow",
      "output": "YELLOW"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s1"
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s2",
      "symbol": "tick"
    },
    {
      "id": "t2",
      "from": "s2",
      "to": "s3",
      "symbol": "tick"
    },
    {
      "id": "t3",
      "from": "s3",
      "to": "s1",
      "symbol": "tick"
    }
  ],
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "Traffic light",
    "blurb": "Red, green, yellow, red: a three-state cycle driven by a timer tick, with the light on each state. The Moore output starts before the first tick, which is why one tick shows two colours.",
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "textbook",
        "moore"
      ],
      "difficulty": "intro"
    },
    "inputs": [
      {
        "w": "",
        "out": "RED",
        "label": "before any tick"
      },
      {
        "w": "tick",
        "out": "RED GREEN"
      },
      {
        "w": "tick tick tick",
        "out": "RED GREEN YELLOW RED"
      },
      {
        "w": "tick tick tick tick",
        "out": "RED GREEN YELLOW RED GREEN"
      }
    ]
  }
}
