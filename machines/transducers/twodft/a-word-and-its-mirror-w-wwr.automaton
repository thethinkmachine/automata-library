  "meta": {
    "title": "A word and its mirror: w ↦ wwᴿ",
    "blurb": "Sweep right printing every letter, then sweep back printing them again. The result is always a palindrome of even length. One-way transducers cannot reverse; a head that can turn round does it with no memory at all.",
    "inputs": [
      {
        "w": "a",
        "out": "aa",
        "expect": "accept"
      },
      {
        "w": "b",
        "out": "bb",
        "expect": "accept"
      },
      {
        "w": "aa",
        "out": "aaaa",
        "expect": "accept"
      },
      {
        "w": "ab",
        "out": "abba",
        "expect": "accept"
      },
      {
        "w": "aaa",
        "out": "aaaaaa",
        "expect": "accept"
      },
      {
        "w": "bbbbbabbaaabbaaa",
        "out": "bbbbbabbaaabbaaaaaabbaaabbabbbbb",
        "expect": "accept"
      }
    ],
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "reversal",
        "palindromes",
        "two-way"
      ],
      "difficulty": "intro"
    }
  }
