  "notes": [],
  "dividers": [],
  "blocks": [],
  "meta": {
    "title": "Reverse every word",
    "blurb": "Letters are pushed as they arrive; a space, written _, pops the word back out reversed and then prints the space. “ab_cde” becomes “ba_edc”: a stack reverses, and a separator says when.",
    "inputs": [
      {
        "w": "_",
        "out": "_",
        "expect": "accept"
      },
      {
        "w": "a",
        "out": "a",
        "expect": "accept"
      },
      {
        "w": "__",
        "out": "__",
        "expect": "accept"
      },
      {
        "w": "_a",
        "out": "_a",
        "expect": "accept"
      },
      {
        "w": "___",
        "out": "___",
        "expect": "accept"
      },
      {
        "w": "bbb_aa_b_abaa__a",
        "out": "bbb_aa_b_aaba__a",
        "expect": "accept"
      }
    ],
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "reversal",
        "text-processing",
        "stack"
      ],
      "difficulty": "intro"
    }
  }
}
