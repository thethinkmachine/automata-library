      "eps": "ε",
      "any": "Σ",
      "blank": "⊔",
      "leftMarker": "⊢",
      "rightMarker": "⊣",
      "stackBottom": "Z",
      "lambda": "λ"
    },
    "pdaParadigm": "explicit",
    "transducerAccepts": true
  },
  "sigma": [
    "a",
    "b",
    "_"
  ],
  "stackAlpha": [
    "Z",
    "A",
    "B"
  ],
  "outputAlpha": [
    "a",
    "b",
    "_"
  ],
  "tapeCount": 1,
