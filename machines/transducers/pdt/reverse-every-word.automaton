      "pop": "ε",
      "push": "ε",
      "output": ""
    },
    {
      "id": "t4",
      "from": "s1",
      "to": "s3",
      "symbol": "ε",
      "pop": "ε",
      "push": "ε",
      "output": ""
    },
    {
      "id": "t5",
      "from": "s2",
      "to": "s2",
      "symbol": "ε",
      "pop": "A",
      "push": "ε",
      "output": "a"
    },
    {
      "id": "t6",
      "from": "s2",
      "to": "s2",
      "symbol": "ε",
      "pop": "B",
      "push": "ε",
