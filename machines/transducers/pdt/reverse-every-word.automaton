      "y": 255,
      "name": "space"
    },
    {
      "id": "s3",
      "x": 319,
      "y": 160,
      "name": "end"
    },
    {
      "id": "s4",
      "x": 498,
      "y": 208,
      "name": "done"
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "pop": "ε",
      "push": "A",
      "output": ""
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "b",
      "pop": "ε",
      "push": "B",
      "output": ""
    },
    {
      "id": "t3",
      "from": "s1",
