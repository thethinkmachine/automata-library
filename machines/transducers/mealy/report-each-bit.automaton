  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "Report each bit",
    "blurb": "The smallest Mealy machine worth drawing: every input bit produces an output word naming it. The outputs sit on the edges, so both states answer each bit the same way — the state records the last bit and nothing depends on it.",
