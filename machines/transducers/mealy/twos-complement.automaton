  "meta": {
    "title": "Two’s complement, least significant bit first",
    "blurb": "Negate a binary number as it streams in, low bit first: copy every bit up to and including the first 1, then flip the rest. Two states, because the only thing to remember is whether that 1 has gone by.",
    "inputs": [
      {
        "w": "0110",
        "out": "0101",
        "label": "−6 = 1010 in four bits"
      },
      {
        "w": "1000",
        "out": "1111",
        "label": "−1"
      },
      {
        "w": "0001",
        "out": "0001",
        "label": "−8 = 8 in four bits"
      },
      {
        "w": "0000",
        "out": "0000",
        "label": "−0"
      }
    ],
