  "meta": {
    "title": "aⁱbʲcⁱ⁺ʲ — addition in unary",
    "blurb": "The sum written out: i a’s plus j b’s equals the number of c’s. The a’s and b’s push the same symbol, so the stack holds i + j, and the c’s pay it off one at a time. Here i + j ≥ 1.",
    "inputs": [
      {
        "w": "ac",
        "expect": "accept"
      },
      {
        "w": "bc",
        "expect": "accept"
      },
      {
        "w": "abcc",
        "expect": "accept"
      },
      {
        "w": "aaabbccccc",
        "expect": "accept",
        "label": "3 + 2 = 5"
      },
      {
        "w": "",
        "expect": "reject"
      },
      {
        "w": "abc",
        "expect": "reject",
        "label": "1 + 1 ≠ 1"
      },
      {
        "w": "aabcccc",
        "expect": "reject",
        "label": "2 + 1 ≠ 4"
      },
      {
        "w": "bac",
        "expect": "reject"
      }
    ],
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "arithmetic",
        "unary",
        "counting"
      ],
      "difficulty": "intro",
      "readme": "Read as arithmetic, **aaabbccccc** says 3 + 2 = 5. A PDA can check it because the two addends are pushed onto one pile and the answer is read off it — addition is the one operation a single stack does for free.\n\nMultiplication is not: the language aⁱbʲcⁱʲ is not context-free, and checking it needs a machine with more than one store. See **aⁿbⁿcⁿ with a queue** or the Turing machines."
    }
  }
}
