{
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "machine": "DPDA",
  "config": {
    "pdaParadigm": "explicit",
    "sym": {
      "eps": "ε",
      "any": "Σ",
      "blank": "⊔",
      "leftMarker": "⊢",
      "rightMarker": "⊣",
      "stackBottom": "Z",
      "lambda": "λ"
    }
  },
  "sigma": [
    "a",
    "b"
  ],
  "stackAlpha": [
    "A",
    "Z"
  ],
  "outputAlpha": [],
  "tapeCount": 1,
  "states": [
    {
      "id": "s1",
      "name": "push AA",
      "x": 0,
      "y": 0
    },
    {
      "id": "s2",
      "name": "pop A",
      "x": 179,
      "y": 0
    },
    {
      "id": "s3",
      "name": "accept",
      "x": 358,
      "y": 0
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "pop": "Z",
      "push": "AAZ"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "pop": "A",
      "push": "AAA"
    },
    {
      "id": "t3",
      "from": "s1",
      "to": "s2",
      "symbol": "b",
      "pop": "A",
      "push": "ε"
    },
    {
      "id": "t4",
      "from": "s2",
      "to": "s2",
      "symbol": "b",
      "pop": "A",
      "push": "ε"
    },
    {
      "id": "t5",
      "from": "s2",
      "to": "s3",
      "symbol": "ε",
      "pop": "Z",
      "push": "Z"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s3"
  ],
  "notes": [],
  "dividers": [],
  "blocks": [],
  "meta": {
    "title": "aⁿb²ⁿ — twice as many b’s",
    "blurb": "Every a pushes two symbols, every b pops one, and the word is accepted when the stack is back to its bottom marker. A one-line change to the aⁿbⁿ machine — the stack can count in any fixed ratio.",
    "inputs": [
      {
        "w": "abb",
        "expect": "accept"
      },
      {
        "w": "aabbbb",
        "expect": "accept"
      },
      {
        "w": "aaabbbbbb",
        "expect": "accept"
      },
      {
        "w": "",
        "expect": "reject"
      },
      {
        "w": "ab",
        "expect": "reject"
      },
      {
        "w": "abbb",
        "expect": "reject"
      },
      {
        "w": "aabbb",
        "expect": "reject"
      },
      {
        "w": "abba",
        "expect": "reject"
      }
    ],
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "counting",
        "textbook"
      ],
      "difficulty": "intro",
      "readme": "The stack counts in units the machine chooses. Pushing **AA** per a and popping **A** per b checks that there are exactly twice as many b's; pushing three and popping two would check a 2 : 3 ratio, and so on — any linear relation between two blocks of letters.\n\nThe acceptance is by final state, with the explicit bottom marker **Z** as the test for \"empty\": the ε-move to *accept* can only fire once every A has been popped. Here n ≥ 1; the empty word is rejected."
    }
  }
}
