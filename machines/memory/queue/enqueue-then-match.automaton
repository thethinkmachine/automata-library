      "x": 360,
      "y": 220,
      "name": "q1"
    },
    {
      "id": "s3",
      "x": 580,
      "y": 220,
      "name": "acc"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s3"
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s2",
      "symbol": "a",
      "pop": "ε",
