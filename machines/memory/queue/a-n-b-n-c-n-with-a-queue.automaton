  "meta": {
    "title": "aⁿbⁿcⁿ with a queue",
    "blurb": "The language no stack can check, checked with a FIFO. Each a joins the queue as an A; each b takes an A off the front and puts a B on the back; each c takes a B. The count is recycled rather than consumed. Accepts by empty queue.",
    "inputs": [
      {
        "w": "",
        "expect": "accept",
        "label": "ε"
      },
      {
        "w": "abc",
        "expect": "accept"
      },
      {
        "w": "aabbcc",
        "expect": "accept"
      },
      {
        "w": "aaabbbccc",
        "expect": "accept"
      },
      {
        "w": "aabbc",
        "expect": "reject"
      },
      {
        "w": "abbcc",
        "expect": "reject"
      },
      {
        "w": "aabcc",
        "expect": "reject"
