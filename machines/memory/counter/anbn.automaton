{
  "machine": "Counter",
  "sigma": [
    "a",
    "b"
  ],
  "stackAlpha": [
    "1",
    "Z"
  ],
  "states": [
    {
      "id": "s1",
      "x": 120,
      "y": 220,
      "name": "push"
    },
    {
      "id": "s2",
      "x": 360,
      "y": 220,
      "name": "pop"
    },
    {
      "id": "s3",
      "x": 600,
      "y": 220,
      "name": "acc"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s3"
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "pop": "Z",
      "push": "1Z"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "pop": "1",
      "push": "11"
    },
    {
      "id": "t3",
      "from": "s1",
      "to": "s2",
      "symbol": "b",
      "pop": "1",
      "push": "ε"
    },
    {
      "id": "t4",
      "from": "s2",
      "to": "s2",
      "symbol": "b",
      "pop": "1",
      "push": "ε"
    },
    {
      "id": "t5",
      "from": "s2",
      "to": "s3",
      "symbol": "ε",
      "pop": "Z",
      "push": "Z"
    }
  ],
  "config": {
    "pdaParadigm": "explicit"
  },
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "meta": {
    "title": "aⁿbⁿ with one counter",
    "blurb": "Count the a’s up and the b’s down, and accept when the counter is back at zero. aⁿbⁿ needs no more than a single number — the smallest store that takes a machine past the regular languages. Here n ≥ 1.",
    "library": {
      "author": {
        "login": "thethinkmachine"
      },
      "license": "CC-BY-4.0",
      "tags": [
        "textbook",
        "counter"
      ],
      "difficulty": "intro"
    },
    "inputs": [
      {
        "w": "ab",
        "expect": "accept"
      },
      {
        "w": "aabb",
        "expect": "accept"
      },
      {
        "w": "aaabbb",
        "expect": "accept"
      },
      {
        "w": "",
        "expect": "reject"
      },
      {
        "w": "aab",
        "expect": "reject"
      },
      {
        "w": "abb",
        "expect": "reject"
      },
      {
        "w": "abab",
        "expect": "reject"
      }
    ]
  }
}
