{
  "format": "automata-studio/workspace",
  "schema": 1,
  "app": "dev",
  "machine": "NPDA",
  "config": {
    "sym": {
      "eps": "ε",
      "any": "Σ",
      "blank": "⊔",
      "leftMarker": "⊢",
      "rightMarker": "⊣",
      "stackBottom": "Z",
      "lambda": "λ"
    },
    "pdaParadigm": "explicit"
  },
  "sigma": [
    "a",
    "b"
  ],
  "stackAlpha": [
    "A",
    "B",
    "Z"
  ],
  "outputAlpha": [],
  "tapeCount": 1,
  "states": [
    {
      "id": "s1",
      "name": "count",
      "x": 220,
      "y": 220
    },
    {
      "id": "s2",
      "name": "acc",
      "x": 560,
      "y": 220
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "pop": "Z",
      "push": "AZ"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "pop": "A",
      "push": "AA"
    },
    {
      "id": "t3",
      "from": "s1",
      "to": "s1",
      "symbol": "a",
      "pop": "B",
      "push": "ε"
    },
    {
      "id": "t4",
      "from": "s1",
      "to": "s1",
      "symbol": "b",
      "pop": "Z",
      "push": "BZ"
    },
    {
      "id": "t5",
      "from": "s1",
      "to": "s1",
      "symbol": "b",
      "pop": "B",
      "push": "BB"
    },
    {
      "id": "t6",
      "from": "s1",
      "to": "s1",
      "symbol": "b",
      "pop": "A",
      "push": "ε"
    },
    {
      "id": "t7",
      "from": "s1",
      "to": "s2",
      "symbol": "ε",
      "pop": "Z",
      "push": "Z"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s2"
  ],
  "notes": [],
  "dividers": [],
  "blocks": [],
  "meta": {
    "title": "As many a’s as b’s",
    "blurb": "The stack holds the surplus — a run of A’s while a’s lead, a run of B’s while b’s do — and a letter of the other kind cancels one. The guess is only when to stop: on Z the machine may step to accept at any time, and only a guess made at the end of the input counts.",
    "inputs": [
      {
        "w": "",
        "expect": "accept"
      },
      {
        "w": "ab",
        "expect": "accept"
      },
      {
        "w": "abba",
        "expect": "accept"
      },
      {
        "w": "baab",
        "expect": "accept"
      },
      {
        "w": "aabbba",
        "expect": "accept"
      },
      {
        "w": "aab",
        "expect": "reject"
      },
      {
        "w": "b",
        "expect": "reject"
      },
      {
        "w": "abbab",
        "expect": "reject"
      }
    ],
    "library": {
