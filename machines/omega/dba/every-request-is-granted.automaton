  "states": [
    {
      "id": "s1",
      "name": "idle",
      "x": 0,
      "y": 0
    },
    {
      "id": "s2",
      "name": "pending",
      "x": 179,
      "y": 0
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s2",
      "symbol": "r"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "g"
    },
    {
