      "any": "Σ",
      "blank": "⊔",
      "leftMarker": "⊢",
      "rightMarker": "⊣",
      "stackBottom": "Z",
      "lambda": "λ"
    }
  },
  "sigma": [
    "a",
    "b"
  ],
  "stackAlpha": [],
  "outputAlpha": [],
  "tapeCount": 1,
  "states": [
    {
      "id": "s1",
      "x": 140,
      "y": 160,
      "name": "none"
    },
    {
      "id": "s2",
      "x": 319,
      "y": 160,
      "name": "one"
    },
    {
      "id": "s3",
      "x": 498,
      "y": 160,
      "name": "pair"
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "s1",
      "to": "s2",
      "symbol": "a"
    },
    {
      "id": "t2",
      "from": "s1",
      "to": "s1",
      "symbol": "b"
    },
    {
      "id": "t3",
      "from": "s2",
      "to": "s3",
      "symbol": "a"
    },
    {
      "id": "t4",
      "from": "s2",
      "to": "s1",
      "symbol": "b"
    },
    {
      "id": "t5",
      "from": "s3",
      "to": "s3",
      "symbol": "a"
    },
    {
      "id": "t6",
      "from": "s3",
      "to": "s1",
      "symbol": "b"
    }
  ],
  "startId": "s1",
  "accepts": [
    "s3"
  ],
  "notes": [],
  "dividers": [],
  "blocks": [],
  "meta": {
    "title": "Infinitely often, two a’s in a row",
    "blurb": "GF(a ∧ X a). The machine watches for aa and passes through its accepting state each time one completes. An infinite word with infinitely many a’s may still never have two together — (ab)^ω is rejected.",
    "inputs": [
      {
        "w": "(a)",
        "expect": "accept"
      },
      {
        "w": "(aa)",
        "expect": "accept"
      },
      {
        "w": "(aaa)",
        "expect": "accept"
      },
      {
        "w": "(aab)",
        "expect": "accept"
      },
      {
        "w": "(b)",
        "expect": "reject"
      },
      {
        "w": "(ab)",
        "expect": "reject"
      },
      {
        "w": "(ba)",
        "expect": "reject"
      },
      {
        "w": "(bb)",
        "expect": "reject"
      }
    ],
    "library": {
