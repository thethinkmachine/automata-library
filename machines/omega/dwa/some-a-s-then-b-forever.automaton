  "meta": {
    "title": "Some a’s, then b forever",
    "blurb": "The ω-language $a^*b^\\omega$. Every strongly connected component is a single state lying wholly inside F or wholly outside it, which is all a weak automaton asks — and the same drawing read as Büchi or co-Büchi accepts the same words.",
    "inputs": [
      {
        "w": "(b)",
        "expect": "accept"
      },
      {
        "w": "aaa(b)",
        "expect": "accept"
      },
      {
        "w": "ab(bb)",
        "expect": "accept"
      },
      {
        "w": "(a)",
        "expect": "reject"
      },
      {
        "w": "(ab)",
        "expect": "reject"
      },
      {
        "w": "b(a)",
        "expect": "reject"
      },
      {
        "w": "ba(b)",
        "expect": "reject"
      }
    ],
