      {
        "w": "(a)",
        "expect": "accept"
      },
      {
        "w": "(b)",
        "expect": "accept"
      },
      {
        "w": "(aa)",
        "expect": "accept"
      },
      {
        "w": "(ac)",
        "expect": "accept"
      },
